{
  "model": {
    "name": "MAPPO Shared Predictive Queue Reorderer",
    "type": "MAPPO",
    "description": "Single shared actor for predictive queue reordering using 17-dim ward state and 25-action triage/wait grid",
    "version": "1.0.0"
  },
  "architecture": {
    "state_dim": 17,
    "action_dim": 25,
    "hidden_dims": [256, 256, 128],
    "activation": "Tanh",
    "output_activation": "Linear",
    "n_agents": null,
    "agent_names": null,
    "alpha_weights": null
  },
  "features": {
    "state_features": [
      "bed_occupancy_rate",
      "male_bed_occupancy_rate",
      "female_bed_occupancy_rate",
      "queue_length_norm",
      "male_queue_ratio",
      "female_queue_ratio",
      "triage1_proportion",
      "triage2_proportion",
      "triage3_proportion",
      "triage4_proportion",
      "triage5_proportion",
      "longest_wait_norm",
      "avg_wait_norm",
      "hour_sin",
      "hour_cos",
      "predicted_arrival_load",
      "predicted_critical_share"
    ],
    "normalization": "minmax",
    "feature_scaling": {
      "occupancy_rate": [0, 1],
      "queue_length": [0, 40],
      "wait_hours": [0, 48],
      "triage_proportion": [0, 1],
      "predicted_arrival_load": [0, 1],
      "predicted_critical_share": [0, 1]
    }
  },
  "actions": {
    "total": 25,
    "description": "5 triage weights × 5 wait weights grid",
    "w_triage_values": [0.0, 0.25, 0.5, 0.75, 1.0],
    "w_wait_values": [0.0, 0.15, 0.3, 0.5, 0.7]
  },
  "performance_targets": {
    "fairness_score": 0.85,
    "efficiency_score": 0.90,
    "inference_latency_ms": 100,
    "accuracy": 0.85
  }
}
