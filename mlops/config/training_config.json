{
  "training": {
    "epochs": 100,
    "batch_size": 32,
    "validation_split": 0.2,
    "test_split": 0.1,
    "shuffle": true
  },
  "optimizer": {
    "type": "Adam",
    "learning_rate": 0.001,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-8,
    "weight_decay": 1e-5
  },
  "learning_schedule": {
    "type": "StepLR",
    "step_size": 20,
    "gamma": 0.1
  },
  "regularization": {
    "dropout_rate": 0.2,
    "l2_penalty": 1e-5,
    "gradient_clip": 1.0
  },
  "replay_buffer": {
    "size": 10000,
    "prioritized": false
  },
  "loss": {
    "type": "MSE",
    "epsilon": 1e-8
  },
  "model_checkpoint": {
    "save_every_epochs": 5,
    "keep_best_only": true,
    "metric": "validation_loss"
  },
  "early_stopping": {
    "enabled": true,
    "patience": 15,
    "min_delta": 0.001
  }
}
